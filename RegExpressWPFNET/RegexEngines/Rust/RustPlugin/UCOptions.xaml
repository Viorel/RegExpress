<UserControl x:Class="RustPlugin.UCOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RustPlugin"
             xmlns:ui="clr-namespace:RegExpressLibrary.UI;assembly=RegExpressLibrary"
             mc:Ignorable="d" d:DesignWidth="892.329" 
             Loaded="UserControl_Loaded" d:DesignHeight="1898.625">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegExpressLibrary;component/UI/CommonResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ui:CheckboxWithNote">
                <EventSetter Event="Changed" Handler="CheckBox_Changed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Grid Style="{StaticResource DetailsTable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="111"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Crate:" Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=cbxCrate}"/>
            <ComboBox x:Name="cbxCrate" Grid.Row="0" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding crate, FallbackValue='regex'}" SelectionChanged="cbxCrate_SelectionChanged">
                <ui:ComboBoxItemWithVersion Tag ="regex"                Text="regex"                Version="{x:Static local:Versions.Regex}" IsSelected="True" />
                <ui:ComboBoxItemWithVersion Tag ="regex_lite"           Text="regex-lite"           Version="{x:Static local:Versions.RegexLite}" />
                <ui:ComboBoxItemWithVersion Tag ="fancy_regex"          Text="fancy-regex"          Version="{x:Static local:Versions.FancyRegex}" />
                <ui:ComboBoxItemWithVersion Tag ="regress"              Text="regress"              Version="{x:Static local:Versions.Regress}" />
                <ui:ComboBoxItemWithVersion Tag ="resharp"              Text="resharp"              Version="{x:Static local:Versions.Resharp}" />
                <ui:ComboBoxItemWithVersion Tag ="anre"                 Text="regex-anre"           Version="{x:Static local:Versions.Anre}" />
                <ui:ComboBoxItemWithVersion Tag ="real_regex"           Text="real-regex"           Version="{x:Static local:Versions.RealRegex}" />
                <ui:ComboBoxItemWithVersion Tag ="java_regex"           Text="java_regex"           Version="{x:Static local:Versions.JavaRegex}" />
                <ui:ComboBoxItemWithVersion Tag ="regexr"               Text="regexr"               Version="{x:Static local:Versions.Regexr}" />
                <ui:ComboBoxItemWithVersion Tag ="rexile"               Text="rexile"               Version="{x:Static local:Versions.ReXile}" />
                <ui:ComboBoxItemWithVersion Tag ="iregexp_rs"           Text="iregexp-rs"           Version="{x:Static local:Versions.IRegexpRs}" />
                <ui:ComboBoxItemWithVersion Tag ="ferroni"              Text="ferroni"              Version="{x:Static local:Versions.Ferroni}" />
                <ui:ComboBoxItemWithVersion Tag ="rusty_expressions"    Text="rusty_expressions"    Version="{x:Static local:Versions.RustyExpressions}" />
                <ui:ComboBoxItemWithVersion Tag ="derivre"              Text="derivre"              Version="{x:Static local:Versions.Derivre}" />
                <ui:ComboBoxItemWithVersion Tag ="corvus_ecma262"       Text="corvus-regex-ecma262" Version="{x:Static local:Versions.CorvusEcma262}" />
            </ComboBox>
        </Grid>

        <ui:CheckboxWithNote x:Name="chbx_use_builder" Prop="UseBuilder" Text="Use RegexBuilder" Note="" Changed="chbx_use_builder_Changed"/>

        <StackPanel x:Name="pnlRegexBuilderOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">

            <ui:CheckboxWithNote x:Name="chbx_case_insensitive" Prop="case_insensitive" Note="(i) match both upper case and lower case variants"/>
            <ui:CheckboxWithNote x:Name="chbx_multi_line" Prop="multi_line" Note="(m) “^” matches the beginning of lines, “$” matches the end of lines"/>
            <ui:CheckboxWithNote x:Name="chbx_dot_matches_new_line" Prop="dot_matches_new_line" Note="(s) “.” matches anything"/>
            <ui:CheckboxWithNote x:Name="chbx_crlf" Prop="crlf" Note="(R) treat both “\r” and “\n” as line terminator"/>
            <ui:CheckboxWithNote x:Name="chbx_swap_greed" Prop="swap_greed" Note="(U) “a*” finds shortest match, “a*?” finds longest match"/>
            <ui:CheckboxWithNote x:Name="chbx_ignore_whitespace" Prop="ignore_whitespace" Note="(x) ignore whitespaces, allow “#” to start line comments"/>
            <ui:CheckboxWithNote x:Name="chbx_unicode" Prop="unicode" Note="(u) match Unicode characters"/>
            <ui:CheckboxWithNote x:Name="chbx_unicode_mode" Text="unicode_mode" Prop="unicode" Note="(u) match Unicode characters"/>
            <ui:CheckboxWithNote x:Name="chbx_octal" Prop="octal" Note="support octal syntax"/>
            <ui:CheckboxWithNote x:Name="chbx_oniguruma_mode" Prop="oniguruma_mode" Note="do not treat “\&lt;” and “\&gt;” as left and right word-bounds"/>
            <ui:CheckboxWithNote x:Name="chbx_find_not_empty" Prop="find_not_empty" Note="require that matches are non-empty"/>
            <ui:CheckboxWithNote x:Name="chbx_ignore_numbered_groups_when_named_groups_exist" Prop="ignore_numbered_groups_when_named_groups_exist" Note="treat unnamed capture groups as non-capturing when named groups exist"/>
            <ui:CheckboxWithNote x:Name="chbx_seek" Prop="seek" Note="(experimental) enable the Seek pre-filter optimization for hard (backtracking) patterns"/>
            <ui:CheckboxWithNote x:Name="chbx_disallow_empty_match_at_eof_after_newline" Prop="disallow_empty_match_at_eof_after_newline" Note="reject empty matches at the end of the haystack following a trailing newline"/>
            <ui:CheckboxWithNote x:Name="chbx_allow_input_assertion_overrides" Prop="allow_input_assertion_overrides" Note="allow RegexInput assertion suppression overrides at runtime"/>
            <ui:CheckboxWithNote x:Name="chbx_delegate_dfa_skip_cache_capacity_check" Prop="delegate_dfa_skip_cache_capacity_check" Note="whether the reverse lazy DFA built for a variable-length lookbehind may exceed the limit set by `delegate_dfa_size_limit` (or the default)"/>
            <ui:CheckboxWithNote x:Name="chbx_start_text" Prop="start_text" Note="preserves the ^ and \A assertions (if allow_input_assertion_overrides)"/>
            <ui:CheckboxWithNote x:Name="chbx_end_text" Prop="end_text" Note="preserves the $ and \z assertions (if allow_input_assertion_overrides)"/>
            <ui:CheckboxWithNote x:Name="chbx_leftmost_longest" Prop="leftmost_longest" Note="return the longest match"/>
            <ui:CheckboxWithNote x:Name="chbx_fallback" Prop="fallback" Note="delegate pattern to regex crate if REAL cannot run it linearly; forfeits the linear-time guarantee"/>

            <StackPanel Orientation="Vertical">

                <Grid x:Name="pnlRegexCrateLimits" Style="{StaticResource DetailsTable}" Visibility="Collapsed" d:Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=sl}">size__limit:</Label>
                    <TextBox x:Name="sl" Grid.Column="1" Grid.Row="0" Text="{Binding size_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="– byte size limit of compiled regular expression" />

                    <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=dsl}">dfa__size__limit:</Label>
                    <TextBox x:Name="dsl" Grid.Column="1" Grid.Row="1" Text="{Binding dfa_size_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="– byte size of DFA cache" />

                    <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=nl}">nest__limit:</Label>
                    <TextBox x:Name="nl" Grid.Column="1" Grid.Row="2" Text="{Binding nest_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="– nest depth" />
                </Grid>

                <Grid x:Name="pnlFancyRegexCrateLimits" Style="{StaticResource DetailsTable}" Visibility="Collapsed" d:Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=bm}">bytes__mode:</Label>
                    <ComboBox x:Name="bm" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding bytes_mode, FallbackValue='Default'}" SelectionChanged="cbxBytesMode_SelectionChanged" >
                        <ComboBoxItem Tag ="Default"        Content="Default" IsSelected="True" />
                        <ComboBoxItem Tag ="Unicode"        Content="Unicode" />
                        <ComboBoxItem Tag ="Ascii"          Content="Ascii" />
                        <ComboBoxItem Tag ="UnicodeBytes"   Content="UnicodeBytes" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="– input encoding mode" />

                    <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=bl}">backtrack__limit:</Label>
                    <TextBox x:Name="bl" Grid.Column="1" Grid.Row="1" Text="{Binding backtrack_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="– limit for how many times backtracking should be attempted" />

                    <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=delsl}">delegate__size__limit:</Label>
                    <TextBox x:Name="delsl" Grid.Column="1" Grid.Row="2" Text="{Binding delegate_size_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="– approximate size limit of compiled regular expression" />

                    <Label Grid.Column="0" Grid.Row="3" Target="{Binding ElementName=deldsl}">delegate__dfa__size__limit:</Label>
                    <TextBox x:Name="deldsl" Grid.Column="1" Grid.Row="3" Text="{Binding delegate_dfa_size_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="– approximate size of cache used by DFA" />

                    <Label Grid.Column="0" Grid.Row="4" Target="{Binding ElementName=max_prog_size}">max__prog__size:</Label>
                    <TextBox x:Name="max_prog_size" Grid.Column="1" Grid.Row="4" Text="{Binding max_prog_size, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                    <TextBlock Grid.Column="2" Grid.Row="4" Text="– maximum number of VM instructions the compiled program may contain" />

                </Grid>

            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="pnlRegressOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">
            <ui:CheckboxWithNote Prop="case_insensitive" Text="icase" Note="(i) case-insensitive"/>
            <ui:CheckboxWithNote Prop="multi_line" Text="multiline" Note="(m) “^” and “$” match at line separators"/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="dot_all" Note="(s) “.” matches at line separators as well as any other character"/>
            <ui:CheckboxWithNote Prop="no_opt" Note="disable regex IR passes"/>
            <ui:CheckboxWithNote Prop="unicode" Note="(u) Unicode regex"/>
            <ui:CheckboxWithNote Prop="unicode_sets" Note="(v) UnicodeSets regex"/>
        </StackPanel>

        <StackPanel x:Name="pnlResharpOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">
            <ui:CheckboxWithNote Prop="case_insensitive" Text="icase" Note="(i) case-insensitive matching"/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="dot_matches_new_line" Note="(s) `.` matches `\n`; `_` always matches any byte"/>
            <ui:CheckboxWithNote Prop="multi_line" Text="multiline" Note="(m) `^` and `$` match at line boundaries (`\n`) in addition to text boundaries"/>
            <ui:CheckboxWithNote Prop="ignore_whitespace" Text="ignore_whitespace" Note="(x) allow whitespace and `#` comments in the pattern"/>
            <ui:CheckboxWithNote Prop="hardened" Text="hardened" Note="slower, but prevents O(n^2) all-matches blowup on adversarial combinations"/>
            <ui:CheckboxWithNote Prop="unbounded_size" Text="unbounded_size" Note="remove the default pattern size limit for very large regexes"/>

            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Unicode mode:" Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=cbxUnicodeMode}" />
                <ComboBox x:Name="cbxUnicodeMode" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding UnicodeMode, FallbackValue='Default'}" SelectionChanged="cbxUnicodeMode_SelectionChanged" MinWidth="77" >
                    <ComboBoxItem Tag ="Default" Content="Default" IsSelected="True" />
                    <ComboBoxItem Tag ="Ascii" Content="Ascii" />
                    <ComboBoxItem Tag ="Full" Content="Full" />
                    <ComboBoxItem Tag ="Javascript" Content="Javascript" />
                </ComboBox>

                <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=mxdc}" Content="max__dfa__capacity:"/>
                <TextBox x:Name="mxdc" Grid.Column="1" Grid.Row="1" Text="{Binding max_dfa_capacity, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="– max cached DFA states" />

                <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=lcmx}" Content="lookahead__context__max:"/>
                <TextBox x:Name="lcmx" Grid.Column="1" Grid.Row="2" Text="{Binding lookahead_context_max, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Text="– max lookahead context distance" />

            </Grid>
        </StackPanel>

        <StackPanel x:Name="pnlAnreOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">
            <ui:CheckboxWithNote Prop="anre_syntax" Text="ANRE" Note="use ANRE language"/>
        </StackPanel>

        <StackPanel x:Name="pnlJavaRegexOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">
            <ui:CheckboxWithNote Prop="case_insensitive" Text="i" Note="case-insensitive matching"/>
            <ui:CheckboxWithNote Prop="multi_line" Text="m" Note="multiline mode (^ and $ match line boundaries)"/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="s" Note="dotall mode (. matches line terminators)"/>
            <ui:CheckboxWithNote Prop="ignore_whitespace" Text="x" Note="comments mode (whitespace and # comments ignored)"/>
            <ui:CheckboxWithNote Prop="unicode" Text="u" Note="Unicode-aware case folding"/>
            <ui:CheckboxWithNote Prop="unicode_sets" Text="U" Note="Unicode character classes for POSIX properties"/>
            <ui:CheckboxWithNote Prop="d" Text="d" Note="Unix lines mode (only \n is a line terminator)"/>
            <ui:CheckboxWithNote Prop="l" Text="l" Note="literal mode (pattern is treated as a literal string)"/>
        </StackPanel>

        <StackPanel x:Name="pnlRegexrOptions" Orientation="Vertical" Visibility="Collapsed" d:Visibility="Visible">
            <ui:CheckboxWithNote Prop="jit" Text="jit" Note="the regex will be compiled to native machine code for maximum performance"/>
            <ui:CheckboxWithNote Prop="optimize_prefixes" Text="optimize_prefixes" Note="large alternations of literals (like (token1|token2|...|tokenN)) will be optimized by merging common prefixes into a trie structure"/>

            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=regexr_sl}">size__limit:</Label>
                <TextBox x:Name="regexr_sl" Grid.Column="1" Grid.Row="0" Text="{Binding size_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="0" Text="– how large a pattern may expand to" />

                <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=regexr_nl}">nest__limit:</Label>
                <TextBox x:Name="regexr_nl" Grid.Column="1" Grid.Row="1" Text="{Binding nest_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="– how deeply groups, character classes, and inline flag scopes may nest" />

                <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=regexr_bl}">backtrack__limit:</Label>
                <TextBox x:Name="regexr_bl" Grid.Column="1" Grid.Row="2" Text="{Binding backtrack_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Text="– how many steps a backreference search may take" />
            </Grid>

        </StackPanel>

        <StackPanel x:Name="pnlIRegexpRs" Orientation="Vertical">
            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=mm}">MatchMode:</Label>
                <ComboBox x:Name="mm" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding MatchMode, FallbackValue='Full'}" SelectionChanged="cbxMatchMode_SelectionChanged" >
                    <ComboBoxItem Tag ="Full" IsSelected="True">
                        <ui:TextAndNote Text="Full" Note="match complete string"/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag ="Search">
                        <ui:TextAndNote Text="Search" Note="match any substring"/>
                    </ComboBoxItem>
                </ComboBox>
                <!--<TextBlock Grid.Column="2" Grid.Row="0" Text="– matching semantics" />-->

            </Grid>
        </StackPanel>

        <StackPanel x:Name="pnlFerroniOptions" Orientation="Vertical">

            <ui:CheckboxWithNote Prop="case_insensitive" Text="case_insensitive" Note="case-insensitive matching"/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="dot_matches_newline" Note="`.` matches `\n`"/>
            <ui:CheckboxWithNote Prop="multi_line" Text="multi_line_anchors" Note="`^`/`$` matching at every line boundary"/>
            <ui:CheckboxWithNote Prop="ignore_whitespace" Text="extended" Note="whitespace and `#` comments ignored"/>
            <ui:CheckboxWithNote Prop="CAPTURE_GROUP" Text="capture_group" Note="capture unnamed groups even when the pattern also has named groups"/>
            <ui:CheckboxWithNote Prop="reject_backtracking_risks" Text="reject_backtracking_risks" Note="fail to compile a pattern that the backtracking check flags"/>
            <ui:CheckboxWithNote Prop="optimize_backtracking" Text="optimize_backtracking" Note="enable conservative AST rewrites for backtracking-prone patterns"/>
            <ui:CheckboxWithNote Prop="dfa" Text="dfa" Note="enable the single-pattern seek automaton for standard searches"/>

            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=onigsyn}">syntax:</Label>
                <ComboBox x:Name="onigsyn" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding OnigSyntaxType, FallbackValue='OnigSyntaxOniguruma'}" SelectionChanged="cbxOnigSyntaxType_SelectionChanged" >
                    <ComboBoxItem Tag="OnigSyntaxOniguruma" IsSelected="True">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxASIS">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxEmacs">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxGnuRegex">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxGrep">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxJava">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPerl">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPerl_NG">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPosixBasic">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPosixExtended">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPython">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxRuby">
                        <ui:TextAndNote Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Note=""/>
                    </ComboBoxItem>
                </ComboBox>
                <!--<TextBlock Grid.Column="2" Grid.Row="0" Text="– matching semantics" Style="{StaticResource note}" />-->

                <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=timeout}">timeout:</Label>
                <TextBox x:Name="timeout" Grid.Column="1" Grid.Row="1" Text="{Binding timeout, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="ms" />

                <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=fer_retry_limit_in_match}">retry__limit__in__match:</Label>
                <TextBox x:Name="fer_retry_limit_in_match" Grid.Column="1" Grid.Row="2" Text="{Binding retry_limit_in_match, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Text="" />

                <Label Grid.Column="0" Grid.Row="3" Target="{Binding ElementName=fer_retry_limit_in_search}">retry__limit__in__search:</Label>
                <TextBox x:Name="fer_retry_limit_in_search" Grid.Column="1" Grid.Row="3" Text="{Binding retry_limit_in_search, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="3" Text="" />

                <Label Grid.Column="0" Grid.Row="4" Target="{Binding ElementName=match_stack_limit}">match__stack__limit:</Label>
                <TextBox x:Name="match_stack_limit" Grid.Column="1" Grid.Row="4" Text="{Binding match_stack_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="4" Text="" />

            </Grid>

        </StackPanel>

        <StackPanel x:Name="pnlRustyExpressionsOptions" Orientation="Vertical" >

            <ui:CheckboxWithNote Prop="case_insensitive" Text="IGNORECASE" Note=""/>
            <ui:CheckboxWithNote Prop="ignore_whitespace" Text="EXTEND" Note=""/>
            <ui:CheckboxWithNote Prop="multi_line" Text="MULTILINE" Note=""/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="SINGLELINE" Note=""/>
            <ui:CheckboxWithNote Prop="leftmost_longest" Text="FIND_LONGEST" Note=""/>
            <ui:CheckboxWithNote Prop="find_not_empty" Text="FIND_NOT_EMPTY" Note=""/>
            <ui:CheckboxWithNote Prop="NEGATE_SINGLELINE" Text="NEGATE_SINGLELINE" Note=""/>
            <ui:CheckboxWithNote Prop="DONT_CAPTURE_GROUP" Text="DONT_CAPTURE_GROUP" Note=""/>
            <ui:CheckboxWithNote Prop="CAPTURE_GROUP" Text="CAPTURE_GROUP" Note=""/>
            <ui:CheckboxWithNote Prop="NOTBOL" Text="NOTBOL" Note=""/>
            <ui:CheckboxWithNote Prop="NOTEOL" Text="NOTEOL" Note=""/>
            <ui:CheckboxWithNote Prop="IGNORECASE_IS_ASCII" Text="IGNORECASE_IS_ASCII" Note=""/>
            <ui:CheckboxWithNote Prop="WORD_IS_ASCII" Text="WORD_IS_ASCII" Note=""/>
            <ui:CheckboxWithNote Prop="DIGIT_IS_ASCII" Text="DIGIT_IS_ASCII" Note=""/>
            <ui:CheckboxWithNote Prop="SPACE_IS_ASCII" Text="SPACE_IS_ASCII" Note=""/>
            <ui:CheckboxWithNote Prop="POSIX_IS_ASCII" Text="POSIX_IS_ASCII" Note=""/>
            <ui:CheckboxWithNote Prop="TEXT_SEGMENT_EXTENDED_GRAPHEME_CLUSTER" Text="TEXT_SEGMENT_EXTENDED_GRAPHEME_CLUSTER" Note=""/>
            <ui:CheckboxWithNote Prop="TEXT_SEGMENT_WORD" Text="TEXT_SEGMENT_WORD" Note=""/>
            <ui:CheckboxWithNote Prop="NOT_BEGIN_STRING" Text="NOT_BEGIN_STRING" Note=""/>
            <ui:CheckboxWithNote Prop="NOT_END_STRING" Text="NOT_END_STRING" Note=""/>
            <ui:CheckboxWithNote Prop="NOT_BEGIN_POSITION" Text="NOT_BEGIN_POSITION" Note=""/>
            <ui:CheckboxWithNote Prop="CALLBACK_EACH_MATCH" Text="CALLBACK_EACH_MATCH" Note=""/>
            <ui:CheckboxWithNote Prop="MATCH_WHOLE_STRING" Text="MATCH_WHOLE_STRING" Note=""/>
            <ui:CheckboxWithNote Prop="FindAll" Text="Find all" Note="find all occurrences"/>

            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=rsonigsyn}">Syntax:</Label>
                <ComboBox x:Name="rsonigsyn" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding OnigSyntaxType, FallbackValue='OnigSyntaxOniguruma'}" SelectionChanged="cbxOnigSyntaxType_SelectionChanged" >
                    <ComboBoxItem Tag="OnigSyntaxOniguruma" IsSelected="True">
                        <ui:TextAndNote Text="ONIGURUMA" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxASIS">
                        <ui:TextAndNote Text="ASIS" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxEmacs">
                        <ui:TextAndNote Text="emacs" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxGnuRegex">
                        <ui:TextAndNote Text="gnu_regex" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxGrep">
                        <ui:TextAndNote Text="grep" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxJava">
                        <ui:TextAndNote Text="java" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPerl">
                        <ui:TextAndNote Text="perl" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPerl_NG">
                        <ui:TextAndNote Text="perl_ng" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPosixBasic">
                        <ui:TextAndNote Text="posix_basic" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPosixExtended">
                        <ui:TextAndNote Text="posix_extended" Note=""/>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="OnigSyntaxPython">
                        <ui:TextAndNote Text="python" Note=""/>
                    </ComboBoxItem>
                    <!-- No 'Ruby'? -->
                    <ComboBoxItem Tag="OnigSyntaxRuby">
                        <ui:TextAndNote Text="ruby" Note=""/>
                    </ComboBoxItem>
                </ComboBox>
                <!--<TextBlock Grid.Column="2" Grid.Row="0" Text="– matching semantics" />-->

                <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=stack_limit}">stack__limit:</Label>
                <TextBox x:Name="stack_limit" Grid.Column="1" Grid.Row="1" Text="{Binding stack_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="– Maximum backtrack-stack depth" />

                <Label Grid.Column="0" Grid.Row="2" Target="{Binding ElementName=retry_limit_in_match}">retry__limit__in__match:</Label>
                <TextBox x:Name="retry_limit_in_match" Grid.Column="1" Grid.Row="2" Text="{Binding retry_limit_in_match, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Text="– Retry count inside one match attempt" />

                <Label Grid.Column="0" Grid.Row="3" Target="{Binding ElementName=retry_limit_in_search}">retry__limit__in__search:</Label>
                <TextBox x:Name="retry_limit_in_search" Grid.Column="1" Grid.Row="3" Text="{Binding retry_limit_in_search, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="3" Text="– Retry count across a search" />

                <Label Grid.Column="0" Grid.Row="4" Target="{Binding ElementName=subexp_call_limit}">subexp__call__limit:</Label>
                <TextBox x:Name="subexp_call_limit" Grid.Column="1" Grid.Row="4" Text="{Binding subexp_call_limit, UpdateSourceTrigger=PropertyChanged}" TextChanged="tb_TextChanged"/>
                <TextBlock Grid.Column="2" Grid.Row="4" Text="– Maximum `\g` subexp-calls during search" />
            </Grid>

        </StackPanel>

        <StackPanel x:Name="pnlDerivre" Orientation="Vertical">

        </StackPanel>

        <StackPanel x:Name="pnlCorvusEcma262" Orientation="Vertical">
            <ui:CheckboxWithNote Prop="has_indices" Text="has_indices" Note="`d`: accepted for completeness. The positions of the groups are always kept, so it changes nothing"/>
            <ui:CheckboxWithNote Prop="global" Text="global" Note="`g` flag. Not used for matches."/>
            <ui:CheckboxWithNote Prop="case_insensitive" Text="ignore_case" Note="`i`: case is ignored, by the Canonicalize of the mode in force"/>
            <ui:CheckboxWithNote Prop="multi_line" Text="multiline" Note="`m`: `^` and `$` hold at line terminators."/>
            <ui:CheckboxWithNote Prop="dot_matches_new_line" Text="dot_all" Note="`s`: the dot matches line terminators"/>
            <ui:CheckboxWithNote Prop="unicode" Text="unicode" Note="`u`: the grammar of the u flag, and matching by code point"/>
            <ui:CheckboxWithNote Prop="unicode_sets" Text="unicode_sets" Note="`v`: the grammar of the v flag (set notation and properties of strings), and matching by code point"/>
            <ui:CheckboxWithNote Prop="sticky" Text="sticky" Note="`y`: a match only at the position the search starts from"/>
        </StackPanel>

    </StackPanel>

</UserControl>
