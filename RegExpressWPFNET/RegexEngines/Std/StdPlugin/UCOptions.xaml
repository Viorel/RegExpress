<UserControl x:Class="StdPlugin.UCOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StdPlugin"
             xmlns:ui="clr-namespace:RegExpressLibrary.UI;assembly=RegExpressLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="508.472" d:DesignWidth="674.643" 
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegExpressLibrary;component/UI/CommonResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ui:CheckboxWithNote">
                <EventSetter Event="Changed" Handler="CheckBox_Changed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">

        <Grid Style="{StaticResource DetailsTable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="192"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Kind:" Target="{Binding ElementName=cbxCompiler}" />
            <ComboBox x:Name="cbxCompiler" Grid.Column="1" Grid.Row="0" SelectedValuePath="Tag" SelectedValue="{Binding Compiler, FallbackValue='MSVC'}" SelectionChanged="cbxCompiler_SelectionChanged">
                <ui:ComboBoxItemWithVersion Tag="MSVC"          Text="MSVC wregex"              Version="{x:Static local:Versions.MSVC}" IsSelected="True" />
                <ui:ComboBoxItemWithVersion Tag="GCC"           Text="GCC wregex"               Version="{x:Static local:Versions.GCC}" />
                <ui:ComboBoxItemWithVersion Tag="SRELL"         Text="SRELL u8regex"            Version="{x:Static local:Versions.SRELL}" />
                <ui:ComboBoxItemWithVersion Tag="SRELL_LINEAR"  Text="SREL3 u8regex (linear)"   Version="{x:Static local:Versions.SRELL_LINEAR}" />
            </ComboBox>

            <Label Grid.Column="0" Grid.Row="1" Content="Grammar:" Target="{Binding ElementName=cbxGrammar}" />
            <ComboBox x:Name="cbxGrammar" Grid.Column="1" Grid.Row="1" SelectedValuePath="Tag" SelectedValue="{Binding Grammar, FallbackValue='ECMAScript'}" SelectionChanged="cbxGrammar_SelectionChanged">
                <ComboBoxItem Tag="ECMAScript" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" IsSelected="True" />
                <ComboBoxItem Tag="basic" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <ComboBoxItem Tag="extended" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <ComboBoxItem Tag="awk" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <ComboBoxItem Tag="grep" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <ComboBoxItem Tag="egrep" Content="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            </ComboBox>

            <Label Grid.Column="0" Grid.Row="2" Content="Locale:" Target="{Binding ElementName=cbxLocale}" />
            <ComboBox x:Name="cbxLocale" Grid.Column="1" Grid.Row="2" SelectedValuePath="Tag" SelectedValue="{Binding Locale, FallbackValue='C'}" SelectionChanged="cbxLocale_SelectionChanged">
                <ComboBoxItem Tag="C" Content="C" IsSelected="True"/>
                <ComboBoxItem Tag="POSIX" Content="POSIX" />
                <ComboBoxItem x:Name="cbiSystemLocale" Tag="" Content="System" />
            </ComboBox>
            <ComboBox x:Name="cbxLocaleDisabled" Grid.Column="1" Grid.Row="2" SelectedValuePath="Tag" IsEnabled="False" >
                <ComboBoxItem Content="n/a" IsSelected="True" />
            </ComboBox>

        </Grid>

        <Label Content="syntax__option__type" Style="{StaticResource SectionTitle}"/>

        <StackPanel x:Name="pnl2" Orientation="Vertical">
            <ui:CheckboxWithNote Prop="icase" Note="make matches case-insensitive"/>
            <ui:CheckboxWithNote Prop="nosubs" Note="do not keep track of the contents of capture groups"/>
            <ui:CheckboxWithNote Prop="optimize" Note="emphasize speed of matching rather than speed of regular expression compilation"/>
            <ui:CheckboxWithNote Prop="collate" Note="make matches locale-sensitive"/>
            <ui:CheckboxWithNote x:Name="chkMultiline" Prop="multiline" Note="“^” matches the beginning of a line and “$” matches the end of a line"/>
            <ui:CheckboxWithNote x:Name="chkPolynomial" Prop="polynomial" Note="ensure space complexity of compiled regex and time complexity execution are not exponential"/>
            <ui:CheckboxWithNote x:Name="chkDotall" Prop="dotall" Note="“.” matches every code point"/>
            <ui:CheckboxWithNote x:Name="chkUnicodesets" Prop="unicodesets" Note="“v-mode”, more unicode features"/>
            <ui:CheckboxWithNote x:Name="chkVMode" Prop="vmode" Note="“v-mode”, more unicode features"/>
        </StackPanel>

        <Label Content="match__flag__type" Style="{StaticResource SectionTitle}"/>

        <StackPanel x:Name="pnl1" Orientation="Vertical">
            <ui:CheckboxWithNote Prop="match_not_bol" Note="do not treat the first position in the target sequence as the beginning of a line"/>
            <ui:CheckboxWithNote Prop="match_not_eol" Note="do not treat the past-the-end position in the target sequence as the end of a line"/>
            <ui:CheckboxWithNote Prop="match_not_bow" Note="do not treat the first position in the target sequence as the beginning of a word"/>
            <ui:CheckboxWithNote Prop="match_not_eow" Note="do not treat the past-the-end position in the target sequence as the end of a word"/>
            <ui:CheckboxWithNote Prop="match_any" Note="if more than one match is possible any match is acceptable"/>
            <ui:CheckboxWithNote Prop="match_not_null" Note="do not treat an empty subsequence as a match"/>
            <ui:CheckboxWithNote Prop="match_continuous" Note="do not search for matches other than at the beginning of the target sequence"/>
            <ui:CheckboxWithNote Prop="match_prev_avail" Note="'--first' is a valid iterator; ignore match_not_bol and match_not_bow if set"/>
        </StackPanel>

        <Grid x:Name="pnlSRELLConstants" Style="{StaticResource DetailsTable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="77"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" x:Name="lbl_limit_counter" Content="limit__counter:" Target="{Binding ElementName=tb_limit_counter}" />
            <TextBox Grid.Column="1" Grid.Row="0" x:Name="tb_limit_counter" Text="{Binding limit_counter, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
            <TextBox Grid.Column="1" Grid.Row="0" x:Name="tb_limit_counter_DISABLED" Text="" IsEnabled="False" />
            <TextBlock Grid.Column="2" Grid.Row="0" Text="– maximum number of backtracking" />

            <Label Grid.Column="0" Grid.Row="1" Content="max__dfacache:" Target="{Binding ElementName=tb_max_dfacache}" />
            <TextBox Grid.Column="1" Grid.Row="1" x:Name="tb_max_dfacache" Text="{Binding max_dfacache, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
            <TextBlock Grid.Column="2" Grid.Row="1" Text="– DFA cache size (bytes)" />

            <Label Grid.Column="0" Grid.Row="2" Content="max__states:" Target="{Binding ElementName=tb_max_states}" />
            <TextBox Grid.Column="1" Grid.Row="2" x:Name="tb_max_states" Text="{Binding max_states, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
            <TextBlock Grid.Column="2" Grid.Row="2" Text="– maximum state number" />

        </Grid>

    </StackPanel>

</UserControl>
