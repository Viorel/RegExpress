<UserControl x:Class="CompileTimeRegexPlugin.UCOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompileTimeRegexPlugin"
             xmlns:ui="clr-namespace:RegExpressLibrary.UI;assembly=RegExpressLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="217.378" d:DesignWidth="391.642" 
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RegExpressLibrary;component/UI/CommonResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ui:CheckboxWithNote">
                <EventSetter Event="Changed" Handler="CheckBox_Changed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">

        <Grid Style="{StaticResource DetailsTable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Kind:" Target="{Binding ElementName=Kind}" />
            <ComboBox x:Name="Kind" Grid.Row="0" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Kind, FallbackValue='Ctre'}" SelectionChanged="cbxKind_SelectionChanged">
                <ui:ComboBoxItemWithVersion Tag ="Ctre"     Text="compile-time-regular-expressions"     Version="{x:Static local:Versions.Ctre}" IsSelected="True" />
                <ui:ComboBoxItemWithVersion Tag ="MRegex"   Text="mregex"                               Version="{x:Static local:Versions.MRegex}" />
            </ComboBox>
        </Grid>

        <StackPanel x:Name="pnlCtre" Orientation="Vertical">

            <ui:CheckboxWithNote Prop="case_insensitive"/>
            <ui:CheckboxWithNote Prop="multiline"/>
            <ui:CheckboxWithNote Prop="singleline"/>

            <Label Content="Compiler options" Style="{StaticResource SectionTitle}"/>

            <Grid Style="{StaticResource DetailsTable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="77"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=tbTemplateDepth}">/templateDepth:</Label>
                <TextBox x:Name="tbTemplateDepth" Grid.Column="1" Grid.Row="0" Text="{Binding TemplateDepth, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
                <TextBlock Grid.Column="2" Grid.Row="0" Text="– depth of recursively instantiated templates" />
            </Grid>

        </StackPanel>

        <StackPanel x:Name="pnlMRegexp" Orientation="Vertical">

            <ui:CheckboxWithNote Prop="case_insensitive" Text="icase" Note="Makes matching case-insensitive"/>
            <ui:CheckboxWithNote Prop="singleline" Text="dotall" Note="Makes wildcards (.) match line break characters"/>
            <ui:CheckboxWithNote Prop="ungreedy" Text="ungreedy" Note="Swaps the behavior of lazy and greedy quantifiers"/>
            <ui:CheckboxWithNote Prop="unroll" Text="unroll" Note="Enables the compiler to be more aggressive when unrolling repetition loops"/>

        </StackPanel>

    </StackPanel>

</UserControl>
