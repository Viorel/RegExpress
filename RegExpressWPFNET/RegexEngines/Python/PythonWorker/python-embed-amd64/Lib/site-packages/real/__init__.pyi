from collections.abc import Callable, Iterable, Iterator
from typing import Any, Final, final, overload

__all__ = [
    "compile", "match", "fullmatch", "search", "findall", "count_matches",
    "finditer", "split", "sub", "subn", "escape", "purge", "error", "Pattern",
    "Match", "RegexSet", "A", "ASCII", "I", "IGNORECASE", "M", "MULTILINE",
    "S", "DOTALL", "X", "VERBOSE", "U", "UNICODE", "NOFLAG", "get_include",
    "get_config",
]

__version__: str

# The module-level fallback policy: True delegates a pattern the linear engine
# cannot represent to the standard library re, forfeiting its linear-time guarantee.
fallback: bool

NOFLAG: Final[int]
I: Final[int]
IGNORECASE: Final[int]
M: Final[int]
MULTILINE: Final[int]
S: Final[int]
DOTALL: Final[int]
U: Final[int]
UNICODE: Final[int]
X: Final[int]
VERBOSE: Final[int]
A: Final[int]
ASCII: Final[int]

class error(Exception): ...

@final
class Pattern:
    @property
    def pattern(self) -> str | bytes: ...
    @property
    def engine(self) -> str: ...
    @property
    def flags(self) -> int: ...
    @property
    def groups(self) -> int: ...
    @property
    def groupindex(self) -> dict[str, int]: ...
    def match(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> Match | None: ...
    def fullmatch(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> Match | None: ...
    def search(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> Match | None: ...
    def findall(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> list[Any]: ...
    def count_matches(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> int: ...
    def finditer(self, string: str | bytes, pos: int = ..., endpos: int = ...) -> Iterator[Match]: ...
    def split(self, string: str | bytes, maxsplit: int = ...) -> list[Any]: ...
    def sub(
        self,
        repl: str | bytes | Callable[[Match], str | bytes],
        string: str | bytes,
        count: int = ...,
    ) -> str | bytes: ...
    def subn(
        self,
        repl: str | bytes | Callable[[Match], str | bytes],
        string: str | bytes,
        count: int = ...,
    ) -> tuple[str | bytes, int]: ...

@final
class Match:
    @property
    def re(self) -> Pattern: ...
    @property
    def string(self) -> str | bytes: ...
    @property
    def pos(self) -> int: ...
    @property
    def endpos(self) -> int: ...
    @property
    def lastindex(self) -> int | None: ...
    @property
    def lastgroup(self) -> str | None: ...
    @property
    def regs(self) -> tuple[tuple[int, int], ...]: ...
    @overload
    def group(self, group: int | str = ..., /) -> str | bytes | None: ...
    @overload
    def group(
        self, group1: int | str, group2: int | str, /, *groups: int | str
    ) -> tuple[str | bytes | None, ...]: ...
    def groups(self, default: Any = ...) -> tuple[str | bytes | None, ...]: ...
    def groupdict(self, default: Any = ...) -> dict[str, str | bytes | None]: ...
    def start(self, group: int | str = ..., /) -> int: ...
    def end(self, group: int | str = ..., /) -> int: ...
    def span(self, group: int | str = ..., /) -> tuple[int, int]: ...
    def expand(self, template: str | bytes, /) -> str | bytes: ...
    def __getitem__(self, key: int | str, /) -> str | bytes | None: ...

class RegexSet:
    flags: int
    def __init__(self, patterns: Iterable[str | bytes], flags: int = ...) -> None: ...
    def __len__(self) -> int: ...
    def is_match(self, string: str | bytes, pos: int = ..., endpos: int | None = ...) -> bool: ...
    def matches(self, string: str | bytes, pos: int = ..., endpos: int | None = ...) -> list[bool]: ...
    def which(self, string: str | bytes, pos: int = ..., endpos: int | None = ...) -> list[int]: ...

def compile(
    pattern: str | bytes | Pattern, flags: int = ..., fallback: bool | None = ...
) -> Pattern: ...
def match(pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...) -> Match | None: ...
def fullmatch(
    pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...
) -> Match | None: ...
def search(pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...) -> Match | None: ...
def findall(pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...) -> list[Any]: ...
def count_matches(pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...) -> int: ...
def finditer(
    pattern: str | bytes | Pattern, string: str | bytes, flags: int = ...
) -> Iterator[Match]: ...
def split(
    pattern: str | bytes | Pattern, string: str | bytes, maxsplit: int = ..., flags: int = ...
) -> list[Any]: ...
def sub(
    pattern: str | bytes | Pattern,
    repl: str | bytes | Callable[[Match], str | bytes],
    string: str | bytes,
    count: int = ...,
    flags: int = ...,
) -> str | bytes: ...
def subn(
    pattern: str | bytes | Pattern,
    repl: str | bytes | Callable[[Match], str | bytes],
    string: str | bytes,
    count: int = ...,
    flags: int = ...,
) -> tuple[str | bytes, int]: ...
@overload
def escape(pattern: str) -> str: ...
@overload
def escape(pattern: bytes) -> bytes: ...
def purge() -> None: ...
def get_include() -> str: ...
def get_config() -> dict[str, str]: ...
